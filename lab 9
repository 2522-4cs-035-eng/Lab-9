#include <iostream>
using namespace std;

class IntList {
    int* data = new int[2];
    int count = 0, capacity = 2;

    void grow() {
        cout << "Resizing: " << capacity << " = " << capacity * 2 << endl;
        capacity *= 2;
        int* temp = new int[capacity];
        for (int i = 0; i < count; i++) temp[i] = data[i];
        delete[] data;
        data = temp;
    }	

public:
    ~IntList() {
        delete[] data;
        cout << "IntList memory freed" << endl;
    }

    void add(int v) {
        if (count == capacity) grow();
        data[count++] = v;
    }

    int get(int i) {
        if (i < 0 || i >= count) {
            cout << "Invalid index " << i << endl;
            return -1;
        }
        return data[i];
    }

    int size() { return count; }

    void print() {
        cout << "List (" << count << "/" << capacity << "): ";
        for (int i = 0; i < count; i++) cout << data[i] << " ";
        cout << endl;
    }
};

int main() {
    IntList list;
    for (int i = 10; i <= 60; i += 10) list.add(i);

    list.print();
    cout << "Item at 3: " << list.get(3) << endl;
    cout << "Item at 10: " << list.get(10) << endl;
    cout << "Size: " << list.size() << endl;
}
