#include <iostream>
#include <string>
using namespace std;

template <typename T>
class Stack {
    T* items;
    int capacity, top = 0;

public:
    Stack(int cap) {
        capacity = cap;
        items = new T[cap];
    }

    ~Stack() { delete[] items; }

    bool isEmpty() { return top == 0; }
    bool isFull() { return top == capacity; }
    int size() { return top; }

    void push(T val) {
        if (isFull()) {
            cout << "Stack is full, cannot push " << val << endl;
            return;
        }
        items[top++] = val;
    }

    T pop() {
        if (isEmpty()) {
            cout << "Stack is empty" << endl;
            return T();
        }
        return items[--top];
    }

    T peek() {
        if (isEmpty()) return T();
        return items[top - 1];
    }
};

int main() {
    Stack<int> s1(3);
    s1.push(10); s1.push(20); s1.push(30); s1.push(40);
    cout << "Popping: ";
    while (!s1.isEmpty()) cout << s1.pop() << " ";
    cout << endl;

    string word = "LAHORE";
    Stack<char> s2(word.length());
    for (char c : word) s2.push(c);
    cout << "LAHORE reversed: ";
    while (!s2.isEmpty()) cout << s2.pop();
    cout << endl;

    Stack<string> s3(5);
    s3.push("google.com");
    s3.push("github.com");
    s3.push("gutech.edu.pk");

    cout << "Current page: " << s3.peek() << endl;
    s3.pop(); 
    cout << "After Back: " << s3.peek() << endl;
}
